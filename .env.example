# Daily GitHub Agent Configuration
# Copy this file to .env and fill in values as needed

# GitHub settings (authentication comes from GitHub CLI)
GITHUB_DEFAULT_VISIBILITY=public

# Project generation paths
PROJECTS_DIRECTORY=generated_projects
PROJECT_HISTORY_FILE=data/projects.json

